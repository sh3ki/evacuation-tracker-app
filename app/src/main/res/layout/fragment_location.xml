<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Map View -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dropdown at the top -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingEnd="12dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/evacuationSiteDropdownLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Evacuation Sites"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                <AutoCompleteTextView
                    android:id="@+id/evacuationSiteDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="14sp"
                    android:padding="12dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/filterButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Filter evacuation sites"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="@color/primary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Show Favorites Button (bottom right, above My Location) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabShowFavorites"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:layout_marginBottom="170dp"
        android:contentDescription="Show Favorite Evacuation Centers"
        app:srcCompat="@android:drawable/star_big_on"
        app:tint="@android:color/holo_orange_light"
        app:backgroundTint="@android:color/white" />

    <!-- My Location Button (bottom right) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:layout_marginBottom="90dp"
        android:contentDescription="My Location"
        app:srcCompat="@drawable/ic_my_location"
        app:tint="@android:color/white"
        app:backgroundTint="#4A90E2" />

    <!-- Bottom Sheet for Evacuation Details -->
    <include layout="@layout/bottom_sheet_evacuation_details" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
